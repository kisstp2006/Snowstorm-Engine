# Directories
.vs/
.venv/
build/
Vendor/Binaries
# vcpkg itself is a git submodule; only its build outputs are ignored.
vcpkg/installed/
vcpkg/buildtrees/
vcpkg/packages/
vcpkg/downloads/
Engine/cache
# Downloaded AMD tools (Radeon GPU Analyzer / Developer Tool Suite), not source — never commit.
Tools/rga/
Tools/rdts/

# Files
*.vcxproj
*.vcxproj.user
*.vcxproj.filters
*.sln
*.slnx
*.log
*.json
# Build entry points are real sources despite the blanket *.json ignore.
!vcpkg.json
!CMakePresets.json
# Per-user preset overrides stay local.
CMakeUserPresets.json
*.DotSettings
*.DotSettings.user
*.ini
*.cmake
CMakeCache.txt
ALL_BUILD.*
ZERO_CHECK.*
Makefile

# Local vcpkg overlay ports are real sources and MUST be committed, despite the
# blanket *.json / *.cmake ignores above (those target generated build files).
!Scripts/vcpkg-overlays/
!Scripts/vcpkg-overlays/**

# AssetRegistry.json is a machine-local cache rebuilt by the asset scan from the committed
# `<source>.meta` sidecars (which own the GUIDs scenes reference) — Unity's Library/ folder.
# It stays ignored via the blanket *.json above; the .meta files are tracked.

# Editor fonts are shipped assets (the NERV theme loads a monospace TTF from here).
!Engine/Fonts/
!Engine/Fonts/**
# Local user settings written by the editor on shutdown (persistent CVars). Machine-local
# state, not project data — must not be committed.
SnowstormConfig.cfg
# Hand-authored startup CVar overrides (dev/machine toggles like validation.extra); read at startup,
# never written by the app. Machine-local, must not be committed.
SnowstormStartup.cfg

# Neural training harness (#99): generated artifacts. Scripts under Tools/neural/ are tracked; the
# captured datasets, trained weights, and Python caches are large/generated and must not be committed.
Dataset/
*.ssnn
*.npy
__pycache__/
.pytest_cache/
