#!/usr/bin/env bash
# Pre-push gate: block a push that CI's `lint` workflow would fail on.
#
# Format-on-touch: every C++ file this branch changes vs master (plus uncommitted edits) must be
# fully clang-format clean -- the same set CI gates on. Needs clang-format on PATH (use 22.x to
# match CI; version drift changes output). Skips with a note when clang-format is not installed.
#
# Enable (once per clone):   git config core.hooksPath .githooks
# Bypass for one push:       git push --no-verify   (or SKIP_FORMAT_HOOK=1 git push)
set -euo pipefail

if [ "${SKIP_FORMAT_HOOK:-}" = "1" ]; then
    echo "pre-push: format check skipped (SKIP_FORMAT_HOOK=1)."
    exit 0
fi

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

if ! command -v clang-format >/dev/null 2>&1; then
    echo "pre-push: clang-format not found on PATH; skipping format check (CI lint still gates)." >&2
    exit 0
fi

base="$(git merge-base HEAD master 2>/dev/null || git merge-base HEAD origin/master 2>/dev/null || echo HEAD)"
files="$( { git diff --name-only --diff-filter=ACMR "$base" -- '*.cpp' '*.hpp' '*.h';
            git diff --name-only --diff-filter=ACMR -- '*.cpp' '*.hpp' '*.h';
            git diff --name-only --cached --diff-filter=ACMR -- '*.cpp' '*.hpp' '*.h'; } \
          | grep -vE 'imgui_impl_' | sort -u | while read -r f; do [ -f "$f" ] && echo "$f"; done; true )"

[ -z "$files" ] && exit 0

if ! echo "$files" | xargs clang-format --dry-run --Werror; then
    echo
    echo "pre-push: clang-format check failed -- CI lint would reject this push." >&2
    echo "  Fix:    clang-format -i <files>   (then re-stage/commit)" >&2
    echo "  Bypass: git push --no-verify" >&2
    exit 1
fi
